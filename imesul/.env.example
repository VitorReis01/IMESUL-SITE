# Endereco publico da Area de Vendas aberto pelos links de produtos e usado por lib/leadClient.js
# para enviar o lead. Em producao, o build/start FALHA ALTO E CLARO se esta variavel nao estiver
# configurada - nunca cai num host antigo/generico (ver data/products.js e next.config.js).
NEXT_PUBLIC_SALES_URL=https://vendas.exemplo.com.br
# Endereco canonico usado em metadata, sitemap e dados estruturados. Configurar EXPLICITAMENTE em
# cada ambiente de deploy - em producao, o build/start FALHA ALTO E CLARO se esta variavel nao
# estiver configurada (nunca cai num host antigo/generico - ver lib/siteUrl.js). Usar o dominio
# comercial real:
SITE_URL=https://www.exemplo.com.br
SITE_LASTMOD=2026-08-01
# Identifica o ambiente de deploy para controle de indexacao (ver lib/siteUrl.js). Unico valor
# que libera indexacao: "production" - qualquer outro valor, ou a variavel ausente, cai em
# noindex por padrao (postura segura). Configurar explicitamente em cada ambiente:
#   producao real -> SITE_ENV=production
#   homologacao/staging/preview -> SITE_ENV=preview (ou deixar ausente)
#   desenvolvimento local -> nao precisa configurar (fica noindex por padrao)
SITE_ENV=development
# Reforco EXPLICITO de noindex, alem da deteccao automatica por SITE_ENV acima. Configurar como
# "true" em qualquer ambiente de homologacao/preview - nunca em producao real. A deteccao
# automatica ja e fail-safe (so indexa com SITE_ENV=production confirmado), mas esta variavel
# garante noindex mesmo se SITE_ENV for configurada incorretamente por engano.
NEXT_PUBLIC_NOINDEX=false
# Tracking global. Só roda com consentimento de analytics e quando habilitado explicitamente.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_GA_CAMPO_GRANDE_ID=G-9MPFHHNCWY
NEXT_PUBLIC_GA_DOURADOS_ID=G-YV8B6GR2SR
NEXT_PUBLIC_META_PIXEL_ID=958219332423633
# Monitoramento e erros. Deixe desativado na homologação até conectar os serviços externos.
MONITORING_ENABLED=false
MONITORING_HEALTH_SECRET=
CONSENT_SYNC_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
