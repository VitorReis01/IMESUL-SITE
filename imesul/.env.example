# Endereco publico da Area de Vendas aberto pelos links de produtos.
NEXT_PUBLIC_SALES_URL=https://imesul-vendas.vercel.app/
# Endereco canonico usado em metadata, sitemap e dados estruturados. Configurar EXPLICITAMENTE em
# cada ambiente na Vercel (Preview e Production) - sem isso, o app cai num fallback generico
# (nunca o dominio real) e o sitemap/canonical publicados ficam errados (ver relatorio
# FULL-SCOPE/remediacao). Em Production, usar o dominio comercial real:
# SITE_URL=https://www.grupoimesul.com.br
SITE_URL=https://imesul-site.vercel.app
SITE_LASTMOD=2026-08-01
# Reforco EXPLICITO de noindex, alem da deteccao automatica por VERCEL_ENV (ver lib/siteUrl.js).
# Configurar como "true" no ambiente de Preview na Vercel - nunca em Production. A deteccao
# automatica ja e fail-safe (so indexa com VERCEL_ENV=production confirmado), mas esta variavel
# garante noindex mesmo se, por qualquer motivo de configuracao do projeto na Vercel, VERCEL_ENV
# nao chegar ao runtime como esperado.
NEXT_PUBLIC_NOINDEX=false
# Tracking global. Só roda com consentimento de analytics e quando habilitado explicitamente.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_GA_CAMPO_GRANDE_ID=G-9MPFHHNCWY
NEXT_PUBLIC_GA_DOURADOS_ID=G-YV8B6GR2SR
NEXT_PUBLIC_META_PIXEL_ID=958219332423633
# Monitoramento e erros. Deixe desativado na homologação até conectar os serviços externos.
MONITORING_ENABLED=false
MONITORING_HEALTH_SECRET=
CONSENT_SYNC_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
