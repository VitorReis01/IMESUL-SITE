# Endereco usado pelo link de retorno ao site institucional.
NEXT_PUBLIC_INSTITUTIONAL_SITE_URL=https://imesul-site.vercel.app/
# DDI, DDD e numero sem espacos ou pontuacao.
NEXT_PUBLIC_WHATSAPP_NUMBER=556733125600
# Credenciais demo do painel admin. Nao usar NEXT_PUBLIC_ para senhas.
ADMIN_DEMO_USER=
ADMIN_DEMO_PASSWORD=
# Chave server-side para criptografar IP completo usado apenas em investigacao de seguranca.
ANALYTICS_SECURITY_KEY=
# Origem do site institucional para liberar chamadas cross-origin a /api/leads (CTA "Falar no
# WhatsApp" do institucional). Opcional: NEXT_PUBLIC_INSTITUTIONAL_SITE_URL acima ja e aceita
# tambem; configure qualquer uma das duas.
NEXT_PUBLIC_INSTITUTIONAL_URL=
# Minutos de inatividade do carrinho ate contar como "abandonado" nos relatorios. Opcional -
# usa 120 (2h) se nao configurada. Ver lib/leadFlow.js CART_ABANDONMENT_THRESHOLD_MS.
CART_ABANDONMENT_THRESHOLD_MINUTES=
# IMEbot (Fase 2, so ativo para unit = campo-grande) - webhook do WhatsApp Cloud API da Meta.
# NAO configurar com credenciais de teste/inventadas - deixar vazio ate as credenciais reais
# existirem (ver Backend.js/metaSignature.js e app/api/imebot/webhook/route.js).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# URL publica do site de vendas usada para montar links rastreaveis /r/<token> enviados pelo
# IMEbot. Ex.: https://imesul-vendas.vercel.app
IMEBOT_PUBLIC_BASE_URL=
# Segredo server-side para endpoint de processamento de jobs do IMEbot
# (/api/imebot/jobs/process). Usar em Vercel Cron como Authorization: Bearer <valor>.
IMEBOT_CRON_SECRET=
# Configuracoes operacionais dos jobs persistidos de handoff e pos-venda.
IMEBOT_HANDOFF_CHECK_DELAY_MINUTES=
IMEBOT_HANDOFF_MAX_RETRIES=
IMEBOT_POST_SALE_DELAY_MINUTES=
# Segredo do IMEbot PDF Bridge (Authorization: Bearer, nunca query string) - ver
# scripts/imebot-pdf-bridge/README.md e app/api/imebot/bridge/*.
IMEBOT_BRIDGE_SECRET=
