# Postgres (Backend.js/db.js). Sem esta variavel, o app cai no fallback nao-persistente (arquivo
# temp/memoria, so para "npm run dev" local - nunca valido em producao, ver db.js). Use a connection
# string do POOLER (modo "Transaction", geralmente porta 6543) quando o provider for Supabase -
# nao a conexao direta (porta 5432): o pool deste app (DATABASE_POOL_MAX, poucas conexoes por
# instancia) e pensado para ambiente serverless com muitas instancias concorrentes, e o pooler em
# modo transaction e o que o Supabase recomenda para esse cenario. SSL e detectado automaticamente
# (desligado so para localhost/127.0.0.1 ou sslmode=disable na URL - qualquer outro host, incluindo
# Supabase, usa TLS). NUNCA commitar o valor real - preencher so em .env.local (gitignored) ou nas
# env vars do provedor de deploy.
DATABASE_URL=
# Conexoes maximas do pool POR INSTANCIA serverless (nao total). Opcional - usa 3 se nao configurada
# (ver Backend.js/db.js). Manter baixo evita esgotar o limite de conexoes do Postgres quando varias
# instancias da Vercel escalam ao mesmo tempo.
DATABASE_POOL_MAX=
# Endereco usado pelo link de retorno ao site institucional.
NEXT_PUBLIC_INSTITUTIONAL_SITE_URL=https://imesul-site.vercel.app/
# Endereco canonico do site de vendas usado em metadata/canonical.
SALES_SITE_URL=https://imesul-vendas.vercel.app
# DDI, DDD e numero sem espacos ou pontuacao.
NEXT_PUBLIC_WHATSAPP_NUMBER=556733125600
# Credenciais demo do painel admin. Nao usar NEXT_PUBLIC_ para senhas.
ADMIN_DEMO_USER=
ADMIN_DEMO_PASSWORD=
# Chave server-side para criptografar IP completo usado apenas em investigacao de seguranca.
ANALYTICS_SECURITY_KEY=
# Origem do site institucional para liberar chamadas cross-origin a /api/leads (CTA "Falar no
# WhatsApp" do institucional). Opcional: NEXT_PUBLIC_INSTITUTIONAL_SITE_URL acima ja e aceita
# tambem; configure qualquer uma das duas.
NEXT_PUBLIC_INSTITUTIONAL_URL=
# Minutos de inatividade do carrinho ate contar como "abandonado" nos relatorios. Opcional -
# usa 120 (2h) se nao configurada. Ver lib/leadFlow.js CART_ABANDONMENT_THRESHOLD_MS.
CART_ABANDONMENT_THRESHOLD_MINUTES=
# Tracking global. Só roda com consentimento de analytics e quando habilitado explicitamente.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_GA_CAMPO_GRANDE_ID=G-9MPFHHNCWY
NEXT_PUBLIC_GA_DOURADOS_ID=G-YV8B6GR2SR
NEXT_PUBLIC_META_PIXEL_ID=958219332423633
# Monitoramento e erros. Deixe desativado na homologação até conectar os serviços externos.
MONITORING_ENABLED=false
MONITORING_HEALTH_SECRET=
CONSENT_SYNC_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
# Mantém o IMEbot fechado na homologação visual/funcional.
IMEBOT_ENABLED=false
# IMEbot (Fase 2, so ativo para unit = campo-grande) - webhook do WhatsApp Cloud API da Meta.
# NAO configurar com credenciais de teste/inventadas - deixar vazio ate as credenciais reais
# existirem (ver Backend.js/metaSignature.js e app/api/imebot/webhook/route.js).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# URL publica do site de vendas usada para montar links rastreaveis /r/<token> enviados pelo
# IMEbot. Ex.: https://imesul-vendas.vercel.app
IMEBOT_PUBLIC_BASE_URL=
# Segredo server-side para endpoint de processamento de jobs do IMEbot
# (/api/imebot/jobs/process). Usar em Vercel Cron como Authorization: Bearer <valor>.
IMEBOT_CRON_SECRET=
# Configuracoes operacionais dos jobs persistidos de handoff e pos-venda.
IMEBOT_HANDOFF_CHECK_DELAY_MINUTES=
IMEBOT_HANDOFF_MAX_RETRIES=
IMEBOT_POST_SALE_DELAY_MINUTES=
# Segredo do IMEbot PDF Bridge (Authorization: Bearer, nunca query string) - ver
# scripts/imebot-pdf-bridge/README.md e app/api/imebot/bridge/*.
IMEBOT_BRIDGE_SECRET=
